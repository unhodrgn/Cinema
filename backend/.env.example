# Copy to .env at the repository root for local development and Compose.
# Generate a fresh value for each secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DB_PASSWORD=

# Native Flask connection. The Compose service uses db:5432/cinema and cinema_api.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cinema_demo
DB_USER=cinema_api
DB_CONNECT_TIMEOUT=5
APP_TIMEZONE=Asia/Seoul
FLASK_DEBUG=0
AUTH_TOKEN_MAX_AGE_SECONDS=28800
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Browser-visible API origin. Use the server's LAN address for a second device.
API_BASE_URL=http://localhost:5000
FRONTEND_PORT=8080
API_PORT=5000
CINEMA_BIND_HOST=127.0.0.1

# Native integration tests only. TEST_DB_PORT is mandatory for PostgreSQL tests.
# The Compose test profile supplies its own private settings.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=
TEST_DB_ADMIN_USER=
TEST_DB_ADMIN_PASSWORD=

# Setup-only commands read SETUP_DB_HOST, SETUP_DB_PORT, SETUP_DB_NAME,
# SETUP_DB_USER and optional SETUP_DB_PASSWORD from the invoking terminal.
