# Copy this file to .env and fill in real values. Never commit .env.
# Placeholders only: do not put real credentials in this file.

# Signing key (required). It signs the API's Bearer tokens, so anyone who knows it can forge a login.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# PostgreSQL connection (see docs/database/postgresql_flask_integration_contract.md, section 8)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_CONNECT_TIMEOUT=5

# Application timezone for displaying times
APP_TIMEZONE=Asia/Seoul

# Set to 1 only for local development
FLASK_DEBUG=0

# --- Independent frontend and REST API (docs/api/api_contract.md) -------------------------
# The frontend (frontend/server.py) is a separate program on its own origin. The API only
# lets the origins listed here read its answers (browser CORS). Exact origins, comma
# separated, no "*", no path. Scheme, host and port must match what is typed in the browser:
# http://localhost:8080 and http://127.0.0.1:8080 are different origins.
# Empty = no cross-origin access at all.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# How long a login token stays valid, in seconds (60 .. 2592000). Default 28800 = 8 hours.
AUTH_TOKEN_MAX_AGE_SECONDS=28800

# The API itself is started with:   flask --app app run --port 5000
# For a browser on ANOTHER device add: --host 0.0.0.0   (and allow the port in the firewall)
# (or set FLASK_RUN_HOST / FLASK_RUN_PORT). PostgreSQL stays local to the API.
#
# The frontend server reads the settings below from the real process environment ONLY
# (it never reads this file), so set them in the terminal that starts it:
#   FRONTEND_HOST=127.0.0.1                 listen address (0.0.0.0 = reachable from other devices)
#   FRONTEND_PORT=8080
#   API_BASE_URL=http://localhost:5000      the API address AS THE BROWSER REACHES IT
#                                           (a second device needs the server's LAN address)
# Start it with:   python frontend/server.py

# Tests only: PostgreSQL integration tests need a DISPOSABLE test server that you choose
# explicitly. TEST_DB_PORT is required: if it is empty, those tests are skipped and no
# connection is attempted. There is no fallback to DB_PORT, PGPORT or 5432, so tests can
# never reach your normal PostgreSQL service by accident. They create and drop only
# databases named cinema_test_*.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=
# Optional role that may CREATE/DROP the disposable database (needs CREATEDB).
# Falls back to DB_USER / DB_PASSWORD when empty.
TEST_DB_ADMIN_USER=
TEST_DB_ADMIN_PASSWORD=

# --- Setup only: scripts/set_demo_passwords.py ---------------------------------------------
# The seeded demo accounts have passwords nobody knows. This script gives them known ones.
# It is NOT part of the API: it needs a database role that may UPDATE users (the role the API
# runs as does not have that permission), so it uses its own explicit SETUP_DB_* settings and
# NEVER falls back to the DB_* settings above. There are no defaults: all four are required.
# Set them in the terminal that runs the script (it does not read this file), for example:
#   SETUP_DB_HOST=127.0.0.1  SETUP_DB_PORT=...  SETUP_DB_NAME=...  SETUP_DB_USER=...
#   SETUP_DB_PASSWORD=...    (optional)
# then:  python scripts/set_demo_passwords.py --username admin_demo --username customer_demo
# The new password is typed at a hidden prompt (or given in SETUP_NEW_PASSWORD for automation).
